<idea-plugin>
    <id>dev.frankbits.classicicons</id>
    <name>Classic &amp; Custom Icons</name>
    <vendor>frankbits</vendor>
    <description>Uses classic or custom icons while the New UI stays enabled. Select individual icon paths or use presets for automatic replacement in Settings | Appearance &amp; Behavior | Classic Icons.</description>
    <depends>com.intellij.modules.platform</depends>

    <!-- Muss früh instanziiert werden, damit der Patcher vor dem Theme-Patcher der New UI installiert ist -->
    <application-components>
        <component>
            <implementation-class>dev.frankbits.classicicons.ClassicIconsComponent</implementation-class>
        </component>
    </application-components>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="dev.frankbits.classicicons.ClassicIconsStartup"/>
        <applicationConfigurable parentId="appearance"
                                 instance="dev.frankbits.classicicons.ClassicIconsConfigurable"
                                 id="dev.frankbits.classicicons.settings"
                                 displayName="Classic Icons"/>
    </extensions>
</idea-plugin>
